{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(,[a-z0-9][a-z0-9-]*)*$"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "url": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "default": "GET",
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "default": 200,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "body": {
                "$ref": "#/$defs/__schema0"
              },
              "text": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "delay": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "const": "infinite"
                  }
                ]
              }
            },
            "not": {
              "required": [
                "body",
                "text"
              ]
            }
          },
          "sequence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "default": 200,
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "body": {
                  "$ref": "#/$defs/__schema0"
                },
                "text": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "delay": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "const": "infinite"
                    }
                  ]
                }
              },
              "not": {
                "required": [
                  "body",
                  "text"
                ]
              }
            }
          },
          "remove": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "path"
        ],
        "oneOf": [
          {
            "required": [
              "response"
            ]
          },
          {
            "required": [
              "sequence"
            ]
          },
          {
            "required": [
              "remove"
            ]
          }
        ]
      }
    },
    "handlers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "tanstack-query": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "queryKey": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "data": {
                "$ref": "#/$defs/__schema0"
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": [
              "queryKey",
              "data"
            ]
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "ready": {
      "type": "string"
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "click": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "click"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "fill": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "fill",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "select": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "select",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "press": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "press"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "wait": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "wait"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "now": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ]
    }
  },
  "required": [
    "name"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
